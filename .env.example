# ==============================================================================
# Cấu hình Gọi Số Khám Bệnh - audio macOS tạo sẵn
# ==============================================================================

# Voice macOS dùng để tạo 99 file số và 1 file “Đã sẵn sàng”.
# Máy Windows chỉ cần nhận thư mục static/audio, không cần cài macOS.
MACOS_TTS_VOICE=Linh
MACOS_TTS_RATE=170

# Cấu hình Bảng LED Serial Port (nếu có phần cứng kết nối)
LED_COM_PORT=COM8

# Cấu hình mạng máy chủ
PORT=3000
HOST=0.0.0.0
