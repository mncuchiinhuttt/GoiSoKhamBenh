# ==============================================================================
# Cấu hình Gọi Số Khám Bệnh - Kokoro TTS & Server
# ==============================================================================

# Không gian Hugging Face Space chạy Kokoro TTS tiếng Việt
# Mặc định: hugging-apps/kokoro-vietnamese
# Bạn cũng có thể đổi sang Space cá nhân hoặc dinhthuan/Kokoro-Vietnamese
KOKORO_TTS_SPACE=hugging-apps/kokoro-vietnamese

# Giọng đọc:
# - Nữ: diem_trinh (mặc định), mai_linh, mai_loan, my_yen, ngoc_huyen, thuc_trinh
# - Nam: hung_thinh, manh_dung, phat_tai, thanh_dat, tuan_ngoc, duc_an, duc_duy
# (Nếu cấu hình v_female_1 hoặc v_male_1 hệ thống sẽ tự động map tương ứng)
KOKORO_TTS_VOICE=diem_trinh

# Tốc độ đọc (khoảng 0.75 đến 1.25, mặc định 1.0)
KOKORO_TTS_SPEED=1.0

# Endpoint Gradio (mặc định tự động nhận diện: /generate, /synthesize, /predict)
# KOKORO_TTS_ENDPOINT=/generate

# Hugging Face Access Token (Khuyên dùng để tăng hạn mức ZeroGPU không bị ngắt quãng)
# Tạo token miễn phí kiểu Read tại: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cấu hình Bảng LED Serial Port (nếu có phần cứng kết nối)
LED_COM_PORT=COM8

# Cấu hình mạng máy chủ
PORT=3000
HOST=0.0.0.0
